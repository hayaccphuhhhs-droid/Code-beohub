        p.Visible = (n == name)
        TabButtons[n].BackgroundColor3 = (n == name) and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(30, 30, 40)
        TabButtons[n].TextColor3 = (n == name) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 200)
    end
end

