-- ====================== 🛡️ ANTI ADMIN ======================
local AdminList = {"tom_iceren","ctgthecreator"}
local function CheckAdmin()
    for _, player in ipairs(Players:GetPlayers()) do
        local name = player.Name:lower()
        for _, adminName in ipairs(AdminList) do
            if name == adminName:lower() then
                return true, player.Name
            end
        end
    end
    return false, nil
end
local function DisableAllScripts()
    getgenv().SafeAutoSell = false
    getgenv().NWKZ_Anchor = false
    getgenv().PP_Noclip = false
    getgenv().PP_AutoSkillAll = false
    getgenv().PP_Skill_Z = false
    getgenv().PP_Skill_X = false
    getgenv().PP_Skill_C = false
    getgenv().PP_Skill_V = false
    getgenv().WalkOnWater = false
    if CoreGui:FindFirstChild("BeoHubUI") then CoreGui.BeoHubUI.Enabled = false end
    if lp.PlayerGui:FindFirstChild("BeoHubUI") then lp.PlayerGui.BeoHubUI.Enabled = false end
end
local function EnableAllScripts()
    if CoreGui:FindFirstChild("BeoHubUI") then CoreGui.BeoHubUI.Enabled = true end
    if lp.PlayerGui:FindFirstChild("BeoHubUI") then lp.PlayerGui.BeoHubUI.Enabled = true end
end
local function NotifyAdmin(adminName)
    StarterGui:SetCore("SendNotification",{Title="⚠️ ADMIN TRONG SERVER ⚠️",Text="Phát hiện: "..adminName.."\nĐã tắt toàn bộ script!",Duration=5})
end
local function NotifySafe()
    StarterGui:SetCore("SendNotification",{Title="✅ AN TOÀN",Text="Admin đã rời server. Script bật lại!",Duration=5})
end
task.spawn(function()
    while task.wait(1) do
        if getgenv().AntiAdminEnabled then
            local hasAdmin, adminName = CheckAdmin()
            if hasAdmin and not getgenv().AdminInServer then
                getgenv().AdminInServer = true
                DisableAllScripts()
                NotifyAdmin(adminName)
                warn("⚠️ ADMIN ĐÃ VÀO: "..adminName)
            elseif not hasAdmin and getgenv().AdminInServer then
                getgenv().AdminInServer = false
                EnableAllScripts()
                NotifySafe()
                print("✅ Admin đã rời. Script bật lại!")
            end
        end
    end
end)
